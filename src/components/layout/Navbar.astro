---
import { Image } from 'astro:assets';
import logoImg from '@assets/images/cloudnode-logo.png';
import NavbarMobileDrawer from './NavbarMobileDrawer.tsx';
import { useTranslations, type Lang } from '@/i18n/text';

interface Props {
  langSwitchHref: string;
}

const { langSwitchHref } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const navLinks = [
  { label: t('nav.plans'),     href: t('nav.plans.href') },
  { label: t('nav.changelog'), href: t('nav.changelog.href') },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Topbar -->
  <div class="border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-1 pb-2.5 flex items-start justify-end">
      <a
        href={langSwitchHref}
        class="text-xs font-semibold px-3 py-1 rounded border border-gray-300 text-[#063b67] hover:border-[#FF7100] hover:text-[#FF7100] transition-colors"
      >
        {t('nav.langSwitch')}
      </a>
    </div>
  </div>

  <!-- Main navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo (left) -->
    <a href={t('nav.home.href')} class="flex-shrink-0">
      <Image
        src={logoImg}
        alt="Cloudnode"
        height={36}
        class="h-9 w-auto"
      />
    </a>

    <!-- Desktop nav links (right) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-[0.9375rem] font-medium transition-colors',
            currentPath === link.href
              ? 'text-[#FF7100]'
              : 'text-[#063b67] hover:text-[#FF7100]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile drawer island. The language switch lives in the topbar above
         and is always visible, so the drawer doesn't repeat it. -->
    <NavbarMobileDrawer client:load navLinks={navLinks} />
  </div>
</header>
