---

<footer class="bg-[#113156] text-white [&_a]:no-underline">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10">
      <div class="lg:col-span-1">
        <Logo class="h-9 w-auto mb-6 text-white" />
        <ul class="flex gap-3">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                class="w-9 h-9 flex items-center justify-center rounded-full border border-white/20 text-white/80 hover:text-white hover:border-white/60 transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-5 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
        {linkColumns.map((column) => (
          <div>
            <h3 class="text-orange uppercase tracking-wide font-bold text-xs mb-4">
              {column.heading}
            </h3>
            <ul class="space-y-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-white hover:text-orange text-sm transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16 pt-8 border-t border-white/10">
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t('footer.section.latestReleases')}</h3>
        <ul class="space-y-2">
          {latestReleases.map((item) => (
            <li>
              <a href={item.href} class="text-white hover:text-orange text-sm transition-colors underline! underline-offset-2">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t('footer.section.latestBlogs')}</h3>
        <ul class="space-y-2">
          {latestBlogs.map((item) => (
            <li>
              <a href={item.href} class="text-white hover:text-orange text-sm transition-colors underline! underline-offset-2">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-white font-bold text-base mb-4">{t('footer.section.needHelp')}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:support@cloudnode.com" class="text-orange hover:text-orange-dark transition-colors">
              support@cloudnode.com
            </a>
          </li>
          <li class="text-white">+31 20 36 081274</li>
          <li class="text-white">+31 20 521 6226</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 text-center text-sm space-y-3">
      <p class="text-white">{t('footer.copyright')}</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-white/70">
        {legalLinks.map((link, index) => (
          <>
            {index > 0 && <li class="text-white/40" aria-hidden="true">|</li>}
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          </>
        ))}
      </ul>
      <p class="text-white/70">
        Support: +31 20 521 6226 | +44 20 3608 5874 | support@cloudnode.com
      </p>
      <p class="text-white/70">
        KvK number: 06090748 | VAT number: NL821888080B01
      </p>
    </div>
  </div>
</footer>
