---
import { useTranslations, type Lang } from '@/i18n/text';
import Button from '@/components/ui/Button.astro';
import heroVideo from '@assets/videos/servers.webm';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---

<section class="px-4 md:px-6 mt-2">
  <div class="relative rounded-3xl overflow-hidden">
    <video
      src={heroVideo}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      class="absolute inset-0 w-full h-full object-cover"
    ></video>
    <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

    <div class="relative flex flex-col items-center justify-center text-center text-white min-h-[640px] md:min-h-[720px] px-6 py-20 md:py-28">
      <h1 class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl">
        {t('hero.headline')}
      </h1>
      <p class="mt-6 text-base md:text-lg max-w-5xl">
        {t('hero.subheadline')}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <Button variant="primary" href={t('nav.comingSoon.href')}>
          {t('hero.cta.primary')}
        </Button>
        <Button variant="secondary" href={t('nav.comingSoon.href')}>
          {t('hero.cta.secondary')}
        </Button>
      </div>
    </div>
  </div>
</section>
