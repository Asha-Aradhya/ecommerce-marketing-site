---
import { getCollection, render } from 'astro:content';
import { useTranslations, type Lang } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const translate = useTranslations(lang);

const faqEntries = (await getCollection(`pricing-faqs-${lang}`)).sort(
  (firstEntry, secondEntry) => firstEntry.data.order - secondEntry.data.order,
);

const renderedFaqs = await Promise.all(
  faqEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { question: entry.data.question, Content };
  }),
);
---

<section class="py-20 md:py-28">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-5xl font-bold text-navy-dark text-center mb-12 md:mb-16">
      {translate('pricing.faqTitle')}
    </h2>

    <div class="divide-y divide-gray-200">
      {renderedFaqs.map(({ question, Content }) => (
        <details name="faq" class="group py-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4 text-navy-dark font-semibold text-base md:text-lg">
            <span>{question}</span>
            <svg
              class="shrink-0 mt-1 text-navy-dark transition-transform group-open:rotate-180"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="mt-4 text-gray-700 leading-relaxed text-sm md:text-base [&_a]:text-orange [&_a]:hover:text-orange-dark [&_a]:transition-colors">
            <Content />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hide default <summary> marker in webkit browsers */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
