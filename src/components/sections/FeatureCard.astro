---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type IconInput = ImageMetadata | ((props: Record<string, unknown>) => unknown);

interface Props {
  icon: IconInput;
  iconAlt: string;
  title: string;
  description: string;
}

const { icon, iconAlt, title, description } = Astro.props;

const SvgComponent = typeof icon === 'function' ? icon : null;
---

<div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow text-center flex flex-col items-center">
  <div class="mb-6 h-16 w-16 flex items-center justify-center">
    {SvgComponent ? (
      <SvgComponent class="h-full w-auto" role="img" aria-label={iconAlt} />
    ) : (
      <Image src={icon as ImageMetadata} alt={iconAlt} class="h-full w-auto" />
    )}
  </div>
  <h3 class="text-lg font-bold text-navy-dark mb-3">{title}</h3>
  <p class="text-sm text-navy-dark leading-relaxed">{description}</p>
</div>
