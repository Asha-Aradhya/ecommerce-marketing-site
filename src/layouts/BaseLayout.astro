---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  langSwitchHref?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-default.png',
  langSwitchHref: langSwitchHrefOverride,
} = Astro.props;

const lang = (Astro.currentLocale ?? 'en') as Lang;
const allLocales = Object.keys(ui) as Lang[];
const otherLocale = allLocales.find(targetLocale => targetLocale !== lang) ?? 'en';

const currentPath = Astro.url.pathname;
const swapLocale = (path: string, targetLocale: string) =>
  path.replace(/^\/[a-z]{2}\//, `/${targetLocale}/`);

const canonical = new URL(currentPath, Astro.site).href;
const langSwitchHref = langSwitchHrefOverride ?? swapLocale(currentPath, otherLocale);
const hreflang = allLocales.map(targetLocale => ({
  lang: targetLocale,
  href: new URL(swapLocale(currentPath, targetLocale), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- hreflang alternates -->
    {hreflang.map(({ lang: alternateLang, href }) => (
      <link rel="alternate" hreflang={alternateLang} href={href} />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <Navbar langSwitchHref={langSwitchHref} />
    <slot />
    <Footer />
  </body>
</html>
