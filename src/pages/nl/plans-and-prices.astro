---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PricingTabs from '@/components/pricing/PricingTabs';
import Faq from '@/components/pricing/Faq.astro';
import { useTranslations, type Lang } from '@/i18n/text';
import { buildPricingTabsLabels } from '@/components/pricing/pricing-tabs-labels';

const lang = (Astro.currentLocale ?? 'nl') as Lang;
const translate = useTranslations(lang);
const pricingTabsLabels = buildPricingTabsLabels(lang);

const planEntries = await getCollection(`pricing-plans-${lang}`);
const plans = planEntries.map((entry) => ({
  ...entry.data,
  id: entry.id,
}));
---

<BaseLayout
  title={translate('pricing.pageTitle')}
  description={translate('pricing.pageDescription')}
>
  <main>
    <section class="pt-12 md:pt-16 pb-8 text-center max-w-3xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-navy-dark mb-4">
        {translate('pricing.heading')}
      </h1>
      <p class="text-navy-dark text-base md:text-lg">
        {translate('pricing.intro')}
      </p>
      <p class="text-navy-dark text-sm mt-3 italic">
        {translate('pricing.vatNote')}
      </p>
    </section>

    <div class="pb-16">
      <PricingTabs client:load plans={plans} labels={pricingTabsLabels} />
    </div>

    <Faq />
  </main>
</BaseLayout>
