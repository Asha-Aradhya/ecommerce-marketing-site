---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n/text';

const lang = (Astro.currentLocale ?? 'nl') as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('comingSoon.title')} | Hypernode`}
  description={t('comingSoon.body')}
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="text-3xl sm:text-4xl font-semibold text-navy-dark mb-4">
      {t('comingSoon.heading')}
    </h1>
    <p class="text-base text-gray-700 mb-8">
      {t('comingSoon.body')}
    </p>
    <a
      href={t('nav.home.href')}
      onclick="if (window.history.length > 1) { event.preventDefault(); window.history.back(); }"
      class="inline-block text-sm font-medium px-5 py-2.5 rounded bg-orange text-white hover:bg-orange-dark transition-colors"
    >
      {t('comingSoon.back')}
    </a>
  </main>
</BaseLayout>
