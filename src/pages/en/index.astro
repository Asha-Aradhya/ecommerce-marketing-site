---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import FeatureSection from "@/components/sections/FeatureSection.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import LogoStrip from "@/components/sections/LogoStrip.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import ContactFormSection from "@/components/sections/ContactFormSection.astro";
import { getCollection, render } from "astro:content";
import { type Lang } from "@/i18n/ui";

const lang = (Astro.currentLocale ?? "en") as Lang;
const sections = (await getCollection(`homepage-${lang}`)).sort(
  (firstEntry, secondEntry) => firstEntry.data.order - secondEntry.data.order,
);
---

<BaseLayout
  title="Reliable Managed Ecommerce Hosting | Hypernode"
  description="Full automation, 24/7 premium support, and top developer tooling. Expertise in dedicated, cloud, and cluster hosting."
>
  <main>
    <Hero />
    {sections.map(async (entry) => {
      if (entry.data.type === "feature-section") {
        const { Content } = await render(entry);
        return (
          <FeatureSection {...entry.data}>
            <Content />
          </FeatureSection>
        );
      }
      if (entry.data.type === "feature-grid") {
        return <FeatureGrid {...entry.data} />;
      }
      if (entry.data.type === "logo-strip") {
        return <LogoStrip {...entry.data} />;
      }
      if (entry.data.type === "testimonials") {
        return <TestimonialsSection {...entry.data} />;
      }
    })}
    <ContactFormSection />
  </main>
</BaseLayout>
