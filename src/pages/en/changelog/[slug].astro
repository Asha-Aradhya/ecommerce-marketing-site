---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allEntries = (await getCollection('changelog-en')).sort(
    (firstEntry, secondEntry) =>
      secondEntry.data.publishedAt.getTime() - firstEntry.data.publishedAt.getTime(),
  );
  return allEntries.map((entry, entryIndex) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previousEntry: allEntries[entryIndex + 1] ?? null,
      nextEntry: allEntries[entryIndex - 1] ?? null,
    },
  }));
}

const { entry, previousEntry, nextEntry } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const bodyMarkdown = entry.data.body?.trim();

function renderMarkdownToHtml(markdown: string): string {
  const lines = markdown.split('\n');
  const blocks: string[] = [];
  let cursor = 0;
  while (cursor < lines.length) {
    const line = lines[cursor];
    if (line.startsWith('### ')) {
      blocks.push(`<h3>${escapeInline(line.slice(4))}</h3>`);
      cursor += 1;
    } else if (line.startsWith('## ')) {
      blocks.push(`<h2>${escapeInline(line.slice(3))}</h2>`);
      cursor += 1;
    } else if (line.startsWith('# ')) {
      blocks.push(`<h2>${escapeInline(line.slice(2))}</h2>`);
      cursor += 1;
    } else if (line.startsWith('```')) {
      const codeLines: string[] = [];
      cursor += 1;
      while (cursor < lines.length && !lines[cursor].startsWith('```')) {
        codeLines.push(lines[cursor]);
        cursor += 1;
      }
      cursor += 1;
      blocks.push(`<pre><code>${escapeHtml(codeLines.join('\n'))}</code></pre>`);
    } else if (line.startsWith('- ')) {
      const listItems: string[] = [];
      while (cursor < lines.length && lines[cursor].startsWith('- ')) {
        listItems.push(`<li>${escapeInline(lines[cursor].slice(2))}</li>`);
        cursor += 1;
      }
      blocks.push(`<ul>${listItems.join('')}</ul>`);
    } else if (line.trim() === '') {
      cursor += 1;
    } else {
      blocks.push(`<p>${escapeInline(line)}</p>`);
      cursor += 1;
    }
  }
  return blocks.join('\n');
}

function escapeHtml(input: string): string {
  return input
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function escapeInline(input: string): string {
  let output = escapeHtml(input);
  output = output.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  output = output.replace(/`([^`]+)`/g, '<code>$1</code>');
  output = output.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  output = output.replace(/\*([^*]+)\*/g, '<em>$1</em>');
  return output;
}

const bodyHtml = bodyMarkdown ? renderMarkdownToHtml(bodyMarkdown) : null;
---

<BaseLayout
  title={`${entry.data.title} | Hypernode Changelog`}
  description={entry.data.excerpt}
  langSwitchHref="/nl/"
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <a
      href="/en/changelog/"
      class="inline-flex items-center text-sm font-semibold text-orange hover:text-orange-dark transition-colors mb-8"
    >
      ← Back to changelog
    </a>

    <div class="flex items-center gap-3 mb-4 text-xs">
      <span
        class={`inline-block rounded-full px-3 py-1 font-semibold uppercase tracking-wide ${
          entry.data.category === 'Release'
            ? 'bg-blue-pale text-navy-dark'
            : 'bg-orange-light text-navy-dark'
        }`}
      >
        {entry.data.category}
      </span>
      <span class="inline-block rounded-full px-3 py-1 font-semibold uppercase tracking-wide bg-blue-pale/60 text-navy-dark">
        {entry.data.topic}
      </span>
      <time
        datetime={entry.data.publishedAt.toISOString()}
        class="text-gray-500"
      >
        {dateFormatter.format(entry.data.publishedAt)}
      </time>
    </div>

    <h1 class="text-3xl md:text-5xl font-bold text-navy-dark mb-8 leading-tight">
      {entry.data.title}
    </h1>

    {
      bodyHtml ? (
        <article
          class="prose-article text-navy-dark leading-relaxed [&_p]:mb-4 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-6 [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-1 [&_a]:text-orange [&_a]:hover:text-orange-dark [&_a]:transition-colors [&_code]:bg-blue-pale [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_pre]:bg-navy-dark [&_pre]:text-blue-pale [&_pre]:p-4 [&_pre]:rounded-md [&_pre]:overflow-x-auto [&_pre]:my-4 [&_pre>code]:bg-transparent [&_pre>code]:text-blue-pale [&_pre>code]:p-0"
          set:html={bodyHtml}
        />
      ) : (
        <p class="text-navy-dark text-lg leading-relaxed">
          {entry.data.excerpt}
        </p>
      )
    }

    <nav class="mt-16 pt-8 border-t border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        previousEntry ? (
          <a
            href={`/en/changelog/${previousEntry.id}/`}
            class="block group"
          >
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
              ← Previous Post
            </span>
            <span class="block mt-1 text-base font-semibold text-navy-dark group-hover:text-orange transition-colors">
              {previousEntry.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        nextEntry ? (
          <a
            href={`/en/changelog/${nextEntry.id}/`}
            class="block group md:text-right"
          >
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
              Next Post →
            </span>
            <span class="block mt-1 text-base font-semibold text-navy-dark group-hover:text-orange transition-colors">
              {nextEntry.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </main>
</BaseLayout>
