# Strapi (optional — falls back to strapi/seed.json if not set)
# Both vars are server-only (no PUBLIC_ prefix) so the token is never
# exposed to the browser. They are read at build time in content.config.ts.
STRAPI_URL=https://ecommerce-marketing-cms.onrender.com
STRAPI_TOKEN=

# Contact form → CRM forwarding (optional — submissions log to console if not set)
# These are server-only (no PUBLIC_ prefix). Read inside src/pages/api/contact.ts,
# which is a Vercel serverless function. If LEAD_API_URL is set, every submission
# is also POSTed there with the optional Bearer token.
LEAD_API_URL=
LEAD_API_TOKEN=
